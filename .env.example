# ── Supabase (públicas — embutidas no bundle do cliente pelo Vite) ───────────
VITE_SUPABASE_URL="https://xxltytblimzhcyqlvikx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
VITE_SUPABASE_PROJECT_ID="xxltytblimzhcyqlvikx"

# Mesmos valores, lidos pelo SSR/rotas de API via process.env
SUPABASE_URL="https://xxltytblimzhcyqlvikx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
SUPABASE_PROJECT_ID="xxltytblimzhcyqlvikx"

# ── Segredos (NUNCA commitar; em produção usar env vars da Vercel) ──────────
# Supabase service role — bypassa RLS, uso exclusivo no servidor
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Anthropic — usada em /api/generate-resume para estruturar o currículo
ANTHROPIC_API_KEY="sk-ant-..."

# Opcionais: sobrescrevem os defaults do gerador
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_EFFORT="medium"   # low | medium | high | xhigh | max

# ── TPM (Tailor Pre-Meeting) ────────────────────────────────────────────────
# O TPM usa um projeto Supabase PRÓPRIO, separado do tailor-site. Quem autentica
# continua sendo o tailor-site; este projeto só guarda dados e é acessado
# exclusivamente pelo servidor, com a service key. Por isso não existe VITE_*
# aqui: a chave nunca pode ir para o navegador.
TPM_SUPABASE_URL="https://<ref do projeto do TPM>.supabase.co"
TPM_SUPABASE_SERVICE_ROLE_KEY="<service role key do projeto do TPM>"

# Opcional: raspagem do site da empresa antes de gerar o briefing.
# Sem a chave, o TPM funciona igual — só perde o conteúdo do site como fonte
# primária, e passa a depender só da busca na web.
# FIRECRAWL_API_KEY="fc-..."
